<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="logs\**" />
    <Content Remove="logs\**" />
    <EmbeddedResource Remove="logs\**" />
    <None Remove="logs\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 真实的部署机覆盖配置（含客户端 Token、JWT 签名密钥、管理端口令）不进构建产物。
         代价：部署时必须把 config\appsettings.Production.json 手工放到目标目录，
         与客户端侧 appsettings.Production.json 的做法一致（步骤见部署机留档的上线清单，
         该文档含真实公网地址与根域，已在 .gitignore 里排除，不入库）。 -->
    <None Remove="config\appsettings.Production.json" />
  </ItemGroup>

  <!-- 上面那组 Remove 单独用不够：实测 dotnet publish 仍会把该文件拷进产物（2026-10-09 发布到空目录
       后 config\appsettings.Production.json 仍在，且 dotnet msbuild -getItem:Content 里它也在列表中、
       带 CopyToPublishDirectory=PreserveNewest）——config 下的 *.json 是被 SDK 默认项（StaticWebAssets
       那一套 props）在项目体之后加回 Content 的，所以必须在 target 执行阶段再移除一次。
       也不能只靠 .dockerignore 挡：镜像的构建上下文就是 publish 产物目录（Dockerfile 里 COPY . /app），
       产物里带了它，漏一次就是把生产凭证烧进镜像层。 -->
  <Target Name="KeepProdConfigOutOfArtifacts" BeforeTargets="AssignTargetPaths;GetCopyToPublishDirectoryItems">
    <ItemGroup>
      <Content Remove="config\appsettings.Production.json" />
      <None Remove="config\appsettings.Production.json" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <!-- 不要降回 10.0.8：它带进 Microsoft.OpenApi 2.0.0，命中 GHSA-v5pm-xwqc-g5wc
         （CVE-2026-49451，循环 $ref 递归解析导致进程栈溢出，构建时报 NU1903 高危），
         2.x 线自 2.7.5 修复，对应到本包是 10.0.11。
         注：MapOpenApi() 只在 Development 环境挂载，Release 产物里这套依赖不会被路由到，
         但包体与漏洞面仍在，所以仍要跟着升。 -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.8" />
    <!-- 8.0.0 是 .NET 8 代次的包，挂在 net10.0 上属于跨代次凑合用；升到与运行时同代次 -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>
 
  <ItemGroup>
    <ProjectReference Include="..\FastTunnel.Core\FastTunnel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="docker-compose.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Dockerfile">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="uninstall.bat">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="install.bat">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties config_4appsettings_1development_1json__JsonSchema="https://json.schemastore.org/appsettings.json" /></VisualStudio></ProjectExtensions>
</Project>
