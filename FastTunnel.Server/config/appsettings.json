{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        // YARP 每转发一个请求都写两条 Information（"Proxying ..." 与 "Received HTTP/1.1 response ..."），
        // 而 Sink 是同步写的（Console + File 各一份）。本机实测：并发 50 下这直接把隧道吞吐
        // 从 ≈1,100-1,200 rps 压到 ≈500 rps（压掉一半以上）、p50 从 26 毫秒抬到 81 毫秒。
        // 这两条对排障也没价值（访客 URL 与耗时由 FastTunnel 自己的 [5xx] 一行日志承载），
        // 所以单独降到 Warning；要看转发细节时临时改回 Information 即可（改完重启生效，
        // 但记住：改回去之后测到的吞吐会掉一半以上，不要把它当成产品容量）。
        "Yarp.ReverseProxy": "Warning"
      }
    },
    "WriteTo": [
      {
        // 文件日志：容器里已把宿主机 $DATA_DIR/logs 挂到 /app/logs，所以 path 用相对目录 logs
        "Name": "File",
        "Args": {
          "path": "logs/fasttunnel-server-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  // [必选] Kestrel 监听地址：HTTP 站点入口、客户端 WebSocket 控制通道、
  // 客户端回拨的 PROXY 数据通道全部跑在这些端口上（可以多绑几个）。
  // 注意：FastTunnel:BinPort 在当前代码里没有任何读取处，真正生效的只有这一行。
  "urls": "http://*:1270;http://*:8080",
  // 文件日志的实际开关是上面 Serilog:WriteTo:File；这个字段仅作文档标记
  "EnableFileLog": true,
  "FastTunnel": {
    // 已废弃：2.3.0 不再读取该值，监听端口由上面的 urls 决定。保留只为兼容旧配置文件。
    "BinPort": 1270,

    // 可选，绑定的根域名，
    // 客户端需配置SubDomain，实现 ${SubDomain}.${WebDomain}访问内网的站点，注意：需要通过域名访问网站时必选。
    // 仓库里只放占位符；真实域名与 Token 写在 config/appsettings.Production.json（已被 .gitignore 排除，只存在于部署机）
    "WebDomain": "change-me.example.com",

    // 可选，访问“白名单”。⚠ 当前版本这个配置项没有任何代码读取，配了也不会生效（
    // 启动自检发现它非空时会打一行 [SafetyCheck] WRN 提醒）。要限来源请用宿主机
    // 防火墙或前置 Nginx，不要依赖这里。字段保留只是为了旧配置文件能解析过。
    "WebAllowAccessIps": [  ],

    // 可选，是否开启端口转发代理，禁用后不处理Forward类型端口转发.默认false。
    "EnableForward": false,

    // 可选，当不为空时，客户端也必须携带Tokens中的任意一个token，否则拒绝登录。
    // 仓库里只放占位符：真实值换到 config/appsettings.Production.json（只存在于部署机），
    // 并让客户端 appsettings.json 的 FastTunnel:Token 配成同一个值；建议 ≥ 32 位随机串
    // （openssl rand -hex 16）。留成占位符时启动自检会打 [SafetyCheck] WRN 点名。
    "Tokens": [ "change-me-tunnel-token" ],

    // 可选，控制通道空闲超时（秒），0=关闭。开启后服务端会主动断开长时间没有任何控制帧
    // （含客户端 2.3.0 应用层心跳）的会话，用来清理链路静默断开时残留的僵尸客户端。
    // 注意：老版本客户端不发应用层心跳，只能靠 WebSocket 控制帧，建议先升级到 2.3.0 客户端再开。
    "ClientIdleTimeoutSeconds": 0,

    // 可选，链路健康快照日志间隔（秒），每隔这么久写一条 [Snap] 日志：
    // 在线会话数、在办请求数（服务端正在转发的访客请求）、在办隧道数（还开着的反向隧道，含复用池里空闲的）、
    // 累计隧道数（启动以来建过多少条）、每条会话的对端 ip:port、在线/空闲时长、最后帧类型。
    // 定位“不定时重连”靠它看到断开那一刻全局状态（比如是否同时存在两条会话）；
    // 不复用时“在办请求”与“在办隧道”接近 1:1；开复用后两者之差就是池里空闲隧道数；
    // “累计隧道”与请求量一起看就知道隧道复用到底有没有生效（不复用时应接近 1:1）。0=关闭。
    // 粒度 5 秒（配小于 5 的值仍按 5 秒输出一条）。
    "DiagnosticsLogIntervalSeconds": 60,

    // 可选，单个客户端后端的“反向隧道建立”等待上限（秒），0=不限时。默认 10。
    // 计时区间：服务端发出 SwapMsg  ->  客户端回拨 PROXY 把隧道建起来，只包含信令投递与隧道握手。
    // 内网后台的处理时间不在这里，慢接口（30s 报表、300s 导出）不会被它掐断。
    // 同一个站点挂多个客户端实例做主备时，超时就换下一个（默认不复用隧道，每个请求都重新选）。
    // 只有“控制通道已关闭”或会话注销才会把后端从候补名单里摘掉，超时不会。
    "WebBackendWaitSeconds": 10,

    // 可选，同一个后端连续多少次建不了隧道之后，后续请求对它只给缩短后的探测预算
    // （上面窗口的 1/N，下限 1 秒），默认 3。它只改变等多久，不改变候补名单。
    // 超时永不摘除后端：单实例部署时摘掉唯一后端 = 站点直接“没有可用后端”，
    // 而且不重连不会自愈（客户端明明活着）；降级只是排到最后，建上隧道即清零。
    "WebBackendTimeoutTripCount": 3,

    // 可选，站点隧道是否允许跨请求复用，默认 false（不写就是 false）。
    // false：每个请求重新选后端、新建一条隧道，半开的后端最多只坑掉一个请求（在握手窗口内就切走）。
    // true：省“建隧道”本身（本机实测 50 并发 2000 发：不复用建 2000 条隧道，复用只建几十条），
    //       延迟与吞吐有小幅收益（同窗长轮实测：复用 1,406-1,479 rps / p50 21-22 毫秒
    //       vs 不复用 1,138-1,230 rps / p50 26-28 毫秒，约 +21% 吞吐、p50 省 5 毫秒），
    //       但代价是请求会被直接塞进旧隧道，绕过上面的多后端选路：
    //       客户端半开时访问者会干等到响应超时（默认 100 秒）才拿到 504
    //       （实测 504@100.05 秒；不复用时同一发 3.04 秒即降级）。
    //       默认保持 false：好处小、尾风险大。确认链路不会半开且在意那点吞吐才设 true。
    "WebReuseTunnel": false,

    // 可选，转发过程中两次 I/O 之间允许的最大静默（秒），0=沿用默认 100 秒。
    // 跟 WebBackendWaitSeconds 是两件事：那个管隧道握手，这个管后台不出字的时长。
    // 实测卡的是“静默”不是总时长：每 10 秒吐一次字节、共 140 秒的响应默认配置就能过；
    // 憋 110 秒才回首包的接口到 100 秒整会被掐（504；若响应头已发给访客则是半路断流，没有错误码）。
    // 报表、导出这类长时间不出字的接口要么调大它，要么改成边算边下发。
    // 调大没有更外层的兜底：客户端隧道两端写死的 10 分钟 ReadTimeout 实测在转发路径上
    // 不起作用（数据走异步读，实测调到 10 秒也不提前掐 40 秒的后台响应）；改完需重启服务端才生效。
    "WebResponseTimeoutSeconds": 0,

    // 可选，访客 → 服务端 允许的最大请求体（MB），0=不覆盖，沿用 Kestrel 默认的 30,000,000 字节（约 28.6 MiB）。
    // 不配它时，走隧道的上传超过 28.6 MiB 会在服务端直接 413，请求根本不会进内网后台
    // （本机实测：28 MB 过、29 MB 413）。只卡访客送进来的请求体，
    // 响应方向（下载）不受它限制；改完需重启服务端。
    "WebMaxRequestBodySizeMb": 0,

    /**
    * 访问api接口的JWT配置
    * ⚠ 密钥与账号口令不要写在版本库里的这份模板上：把真实值放到同目录的
    *   config/appsettings.Production.json（已被 .gitignore 排除，只存在于部署机）。
    *   它在 appsettings.json 之后加载，同名字段以它为准；改完重启服务端生效。
    *   样例见 config/appsettings.Production.json.example。
    *   服务端启动时会自检，下面三项还是占位符/历史默认值都会打 [SafetyCheck] WRN。
    */
    "Api": {
      "JWT": {
        "ClockSkew": 10,
        "ValidAudience": "https://suidao.io",
        "ValidIssuer": "FastTunnel",
        // 换成 ≥ 32 字节的随机串（openssl rand -base64 48）。仍用历史默认值
        // “This is IssuerSigningKey” 时，拿到它的人可以离线伪造管理端令牌。
        "IssuerSigningKey": "change-me-signing-key-min-32-bytes-please",
        // ⚠ 单位是分钟不是秒（AccountController.GenerateToken 用 AddMinutes）：120 = 2 小时。
        "Expires": 120
      },
      // 口令换成随机值；历史值 admin123 已公开在仓库里，且 GetToken 是匿名接口、
      // CORS 又允许任意来源，不换口令 = 管理端入口向公网开的。
      "Accounts": [
        {
          "Name": "admin",
          "Password": "change-me-admin-password"
        }
      ]
    }
  }
}
