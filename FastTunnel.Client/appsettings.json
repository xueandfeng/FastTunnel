{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      // 定位“不定时重连”至少需要 Warning（会输出“[Control] 会话结束：原因 … Ns 后重连”）；
      // Information 额外记录“控制通道已连上”与每 10 分钟一条的“[Control] 会话健康”汇总；
      // Debug 会多出每次心跳 RTT（每 30s 一条），只看现场时再开。
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        // 文件日志：容器里建议挂 -v $PWD/logs:/app/logs，所以 path 用相对目录 logs
        "Name": "File",
        "Args": {
          "path": "logs/fasttunnel-client-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "FastTunnel": {
    // ⚠ 仓库里这份是模板：服务端地址、Token、内网映射全部占位符。
    //   真实值只写在本机的 appsettings.Production.json（已被 .gitignore 排除）。
    //   原因不只是“不要把内网拓扑写进仓库”：配置对**数组是按下标合并的，不是整体替换**，
    //   所以这里残留的站点在新环境里会被部署机的覆盖文件“追加”而不是替掉，会静默多出一批映射。
    //   换环境时要么在覆盖文件里写全，要么就把这里对应的数组清成 []。
    "Server": {
      // [必选] 服务端ip/域名（来自服务端配置文件的urls参数）
      "ServerAddr": "change-me-server-public-ip-or-domain",
      // [必选] 服务端监听的通信端口（来自服务端配置文件的urls参数）
      "ServerPort": 1270
    },

    // [可选]，服务端 Token，必须与服务端 FastTunnel:Tokens 里的某一个完全一致，否则服务端拒绝登录。
    // ⚠ 下面是模板占位符。上线时换成随机值（openssl rand -hex 16），两端同时改、同时重启。
    //   历史值 yimai@1688.com 已公开在仓库里，旧部署如果还在用它，视为已泄露：
    //   拿到它的人可以挂一个伪客户端注册同名站点，与服务端建反向隧道抢流量。
    "Token": "change-me-tunnel-token",

    // [可选] 应用层心跳间隔（秒），0=关闭。用于刷新 NAT/防火墙会话并探出半开链路，默认 30。
    // 如链路设备空闲超时小于此值，调小它（同时调小 WsKeepAliveSeconds）。
    "HeartbeatSeconds": 30,
    // [可选] WebSocket 控制帧 ping 间隔（秒），0=用 .NET 默认 30 秒，默认 15。
    "WsKeepAliveSeconds": 15,
    // [可选] 断线后首次重连间隔（秒），之后指数退避，默认 5。
    "ReconnectDelaySeconds": 5,
    // [可选] 重连退避上限（秒），默认 60。
    "MaxReconnectDelaySeconds": 60,
    // [可选] 连接前先 ICMP ping 一次（仅排查网络用，会拖慢重连），默认 false。
    "PingBeforeConnect": false,

    /**
     * [可选] 内网web节点配置（模板：只留一条全占位符的样例，真实映射写在覆盖文件里）
     */
    "Webs": [
      {
        // [必选] 内网站点所在内网的ip
        "LocalIp": "change-me-inner-site-ip",
        // [必选] 内网站点监听的端口号
        "LocalPort": 80,
        // [必选] 子域名, 访问本站点时的url为 http://${SubDomain}.${WebDomain}:${ServerPort}
        "SubDomain": "www",
        "WWW": [ "change-me-full-alias-domain" ]
      }
    ]
  }
}
